# APOGEE Backend — copy this file to .env and fill in your values
# Never commit .env to version control

# Server
HOST=0.0.0.0
PORT=8000

# Database — defaults to local SQLite if not set (good for dev)
# For PostgreSQL: postgresql+psycopg2://user:password@host:5432/apogee
DATABASE_URL=sqlite:///./apogee.db

# Gemini API Key (required for AI route generation, optional for MVP)
GEMINI_API_KEY=
